                    </div>
                </div>
                <!-- Slide 2 -->
                <div class="carousel-item">

                
                    <img src="~/images/INAUGURAZIONE-GIAZZERA-02.jpg" class="d-block w-100 object-fit-cover" style="height: 450px;" alt="...">

                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3 mb-3">
                        <h5 class="fw-bold mb-1">Mura in Sasso</h5>
                        <p class="small mb-0">La struttura in sasso profonda 4 metri per mantenere il freddo.</p>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="carousel-item">
                    <img src="~/images/INAUGURAZIONE-GIAZZERA-03.jpg" class="d-block w-100 object-fit-cover" style="height: 450px;" alt="...">

                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3 mb-3">
                        <h5 class="fw-bold mb-1">Finestra di Carico</h5>
                        <p class="small mb-0">Apertura a livello stradale utilizzata d'inverno per caricare il ghiaccio.</p>
                    </div>
                </div>

                
            </div>

            <!-- Controlli Avanti / Indietro -->
            <button class="carousel-control-prev" type="button" data-bs-target="#giazzeraCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
