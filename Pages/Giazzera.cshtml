                <button type="button" data-bs-target="#giazzeraCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#giazzeraCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                <button type="button" data-bs-target="#giazzeraCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
            </div>

            <!-- Contenuto Slide -->
            <div class="carousel-inner">
                <!-- Slide 1 -->


                <div class="carousel-item active">
                    <!-- Sostituisci la div placeholder con  quando hai le immagini -->
                    <img src="~/images/INAUGURAZIONE-UTENSILI-GIAZZERA-01.jpg" class="d-block w-100 object-fit-cover" style="height: 450px;" alt="...">
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3 mb-3">
                        <h5 class="fw-bold mb-1">Utensili per lavorazione</h5>
                        <p class="small mb-0">strumenti e atrezzi usati per modellare il ghiacchio.</p>
                    </div>
                </div>
<!-- Slide 4 -->
                <div class="carousel-item">

                                        <img src="~/images/DSC00706-X-SITO.jpg" class="d-block w-100 object-fit-cover" style="height: 450px;" alt="...">

                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 rounded p-3 mb-3">
                        <h5 class="fw-bold mb-1">Giazzera Ristrutturata</h5>
