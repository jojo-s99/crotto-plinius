@page
@model MenuModel
@inject IOptions<RestaurantSettings> RestaurantOptions
@{
    var settings = RestaurantOptions.Value;
    ViewData["Title"] = "Il Nostro Menu";
    ViewData["MetaDescription"] = "Scopri il menu del Crotto Plinius con piatti tipici lariani, risotti di lago, pasta fresca e dolci artigianali.";
}

<!-- Menu Header -->
<div class="bg-white border-bottom py-4 text-center">
    <div class="container">
        <h1 class="brand-font display-5 mb-2">Il Menu del Crotto</h1>
        <p class="text-muted mb-0 small">Ingredienti a chilometro zero e rispetto per la stagionalità dei prodotti lariani</p>
    </div>
</div>

<!-- Sticky Quick Scroll for Mobile / QR Code navigation -->
@if (Model.Categories.Any())
{
    <div class="category-nav">
        <div class="container d-flex">
            @foreach (var cat in Model.Categories)
            {
                <a href="#cat-@cat.Id">@cat.Name</a>
            }
        </div>
    </div>
}

<div class="container py-4 my-2">
    @if (!Model.Categories.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-x fs-1 text-muted mb-3"></i>
            <h4 class="brand-font">Menu in aggiornamento</h4>
            <p class="text-muted">Il nostro chef sta rinnovando la proposta stagionale. Tornate presto a trovarci!</p>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-10">
                @foreach (var cat in Model.Categories)
                {
                    <section id="cat-@cat.Id" class="pt-4 mb-5">
                        <div class="d-flex align-items-baseline mb-2">
                            <h2 class="menu-category-title h3">@cat.Name</h2>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(cat.Description))
                        {
                            <p class="text-muted small fst-italic mb-3">@cat.Description</p>
                        }

                        <div class="row g-3">
                            @if (!cat.Dishes.Any())
                            {
                                <div class="col-12">
                                    <p class="text-muted small fst-italic">Nessun piatto al momento disponibile in questa sezione.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var dish in cat.Dishes)
                                {
                                    <div class="col-md-6">
                                        <div class="menu-item-row h-100 d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-baseline">
                                                    <span class="menu-item-name">
                                                        @dish.Name
                                                        @if (dish.IsFeatured)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-1 small" style="font-size: 0.65rem;">Specialità</span>
                                                        }
                                                    </span>
                                                    <span class="menu-item-price ms-2">@settings.CurrencySymbol @dish.Price.ToString("F2")</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(dish.Description))
                                                {
                                                    <p class="menu-item-desc">@dish.Description</p>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(dish.Allergens))
                                            {
                                                <div class="menu-item-allergens">
                                                    <i class="bi bi-exclamation-circle me-1"></i>Allergeni: @dish.Allergens
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </section>
                }
            </div>
        </div>

        <div class="text-center py-4 border-top mt-4 text-muted small">
            <p class="mb-1"><i class="bi bi-shield-check me-1"></i>Coperto e servizio inclusi. Per intolleranze o allergie gravi vi invitiamo a informare il nostro personale di sala.</p>
            <p class="mb-0">I piatti contrassegnati potrebbero contenere prodotti abbattuti in loco per garantire la massima freschezza.</p>
        </div>
    }
</div>
