@page
@model IndexModel
@inject IOptions<RestaurantSettings> RestaurantOptions
@{
    var settings = RestaurantOptions.Value;
    ViewData["Title"] = "Benvenuti";
}

<!-- Schema.org Restaurant Structured Data -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Restaurant",
  "name": "@settings.Name",
  "description": "@settings.Description",
  "telephone": "@settings.Phone",
  "email": "@settings.Email",
  "address": {
    "@@type": "PostalAddress",
    "streetAddress": "Via Regina 42",
    "addressLocality": "Torno",
    "addressRegion": "CO",
    "postalCode": "22020",
    "addressCountry": "IT"
  },
  "servesCuisine": "Lombarda, Lariana, Italiana",
  "priceRange": "€€",
  "openingHours": "Tu-Su 12:00-14:30 19:00-22:30",
  "menu": "/menu"
}
</script>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <span class="text-uppercase tracking-wider fw-bold text-warning mb-2 d-inline-block small">Autentica Cucina Lariana</span>
        <h1 class="display-3 fw-bold">@settings.Name</h1>
        <p class="lead">@settings.Tagline</p>
        <p class="mb-4 text-white-50">Scavato nella roccia sulle rive del Lago di Como, dove il tempo si ferma e i sapori della tradizione rivivono intatti.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-page="/Menu" class="btn btn-crotto btn-lg">
                <i class="bi bi-book me-2"></i>Consulta il Menu
            </a>
            <a asp-page="/Contact" class="btn btn-crotto-outline btn-lg">
                <i class="bi bi-geo-alt me-2"></i>Dove Siamo & Prenotazioni
            </a>
        </div>
    </div>
</section>

<!-- Features Intro -->
<section class="py-5 bg-white">
    <div class="container text-center">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-3">
                    <i class="bi bi-egg-fried fs-1 text-danger mb-3"></i>
                    <h4 class="brand-font">Materie Prime Locali</h4>
                    <p class="text-muted small">Pesce freschissimo del Lago di Como, formaggi degli alpeggi e farine macinate a pietra della Valtellina.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3">
                    <i class="bi bi-house-door fs-1 text-danger mb-3"></i>
                    <h4 class="brand-font">Il Crotto Storico</h4>
                    <p class="text-muted small">Una cavità naturale ventilata dal "sorèl", brezza sotterranea costante che garantisce la temperatura ideale per vini e formaggi.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3">
                    <i class="bi bi-cup-straw fs-1 text-danger mb-3"></i>
                    <h4 class="brand-font">Vini e Cantina</h4>
                    <p class="text-muted small">Etichette selezionate dei terrazzamenti lariani, Valtellina Superiore DOCG e una cantina curata con passione.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Dishes from Database -->
@if (Model.FeaturedDishes.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="brand-font mb-2">I Nostri Piatti del Giorno</h2>
                <p class="text-muted">Alcune delle nostre specialità più amate preparate secondo le antiche ricette</p>
            </div>
            <div class="row g-4">
                @foreach (var dish in Model.FeaturedDishes)
                {
                    <div class="col-md-6">
                        <div class="menu-item-row h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h5 class="menu-item-name mb-0">@dish.Name</h5>
                                    <span class="menu-item-price">@settings.CurrencySymbol @dish.Price.ToString("F2")</span>
                                </div>
                                <span class="badge bg-light text-secondary border small mt-1">@dish.Category?.Name</span>
                                @if (!string.IsNullOrWhiteSpace(dish.Description))
                                {
                                    <p class="menu-item-desc">@dish.Description</p>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(dish.Allergens))
                            {
                                <div class="menu-item-allergens mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Allergeni: @dish.Allergens
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-page="/Menu" class="btn btn-crotto">
                    Scopri tutto il Menu Completo <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- Info Callout -->
<section class="py-5 bg-white border-top">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h2 class="brand-font mb-3">La Tua Tavola sul Lago di Como</h2>
                <p class="text-muted mb-4">
                    Che sia per un pranzo estivo all'ombra delle piante secolari o per una cena intima al calore del camino durante l'autunno, Crotto Plinius offre un rifugio di quiete e gusto autentico.
                </p>
                <div class="d-flex gap-4">
                    <div>
                        <h6 class="fw-bold mb-1"><i class="bi bi-clock me-1 text-danger"></i> Orari</h6>
                        <p class="small text-muted mb-0">@settings.OpeningHours</p>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1"><i class="bi bi-telephone me-1 text-danger"></i> Telefono</h6>
                        <p class="small text-muted mb-0">@settings.Phone</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="p-4 border rounded bg-light">
                    <i class="bi bi-qr-code fs-1 text-secondary mb-2"></i>
                    <h5 class="brand-font">Menu Digitale a Tavola</h5>
                    <p class="small text-muted mb-3">Sei già seduto al tavolo? Puoi visualizzare il nostro menu in tempo reale dal tuo smartphone.</p>
                    <a asp-page="/Menu" class="btn btn-outline-secondary btn-sm">Apri Menu per Smartphone</a>
                </div>
            </div>
        </div>
    </div>
</section>
