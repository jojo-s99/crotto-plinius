@page
@model IndexModel
@inject IOptions<RestaurantSettings> RestaurantOptions
@{
    var settings = RestaurantOptions.Value;
    ViewData["Title"] = "Ristorante e Pizzeria";
}

<!-- Schema.org Restaurant Structured Data -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Restaurant",
  "name": "@settings.Name",
  "description": "@settings.Description",
  "telephone": "@settings.Phone",
  "email": "@settings.Email",
  "address": {
    "@@type": "PostalAddress",
    "streetAddress": "Via Vela 62",
    "addressLocality": "Induno Olona",
    "addressRegion": "VA",
    "postalCode": "21056",
    "addressCountry": "IT"
  },
  "servesCuisine": "Lombarda , Italiana",
  "priceRange": "€€",
  "openingHours": "Tu-Su 12:00-14:30 19:00-22:30",
  "menu": "/menu"
}
</script>

<!-- Hero Carousel Section -->
<section class="hero-section position-relative overflow-hidden">
    <!-- Carousel Bootstrap -->
    <div id="heroCarousel" class="carousel slide carousel-fade position-absolute top-0 start-0 w-100 h-100" data-bs-ride="carousel" data-bs-interval="5000">
        <!-- Indicatori (pallini in basso) -->
        <div class="carousel-indicators z-3">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <!-- Immagini del Carousel -->
        <div class="carousel-inner h-100">
            <div class="carousel-item active h-100">
                <img src="~/images/CANCELLO-X-SITO-01.jpg" class="d-block w-100 h-100 object-fit-cover" alt="">
            </div>
            <div class="carousel-item h-100">
                <img src="~/images/entrata.jpg" class="d-block w-100 h-100 object-fit-cover" alt="">
            </div>
            <!-- <div class="carousel-item h-100">
                <img src="~/images/DSC00733-X-SITO-1.jpg" class="d-block w-100 h-100 object-fit-cover" alt="">
            </div> -->
        </div>

        <!-- Frecce Avanti/Indietro -->
        <button class="carousel-control-prev z-3" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Precedente</span>
        </button>
        <button class="carousel-control-next z-3" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Successivo</span>
        </button>
    </div>

    <!-- Overlay scuro + Contenuto (in sovrapposizione sopra le foto) -->
    <div class="hero-overlay position-relative z-2 d-flex align-items-center h-100 py-5">
        <div class="container text-center">
            <!-- <span class="text-uppercase tracking-wider fw-bold text-warning mb-2 d-inline-block small">Simeoni</span> -->
            <h1 class="display-3 fw-bold">@settings.Name</h1>
            <p class="text-uppercase tracking-wider text-warning fw-bold">@settings.Tagline</p>
            <p class="mb-4 text-white-50">Da oltre 30 anni accogliamo i nostri ospiti con la stessa passione di sempre. Vieni a riscoprire i sapori autentici della nostra pizzeria e ristorante</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-page="/Menu" class="btn btn-crotto btn-lg">
                    <i class="bi bi-book me-2"></i>Consulta il Menu
                </a>
                <a asp-page="/Contact" class="btn btn-crotto-outline btn-lg">
                    <i class="bi bi-geo-alt me-2"></i>Dove Siamo & Prenotazioni
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Features Intro -->
<section class="py-5 bg-white">
    <div class="container text-center">
        <div class="row g-4 justify-content-center">
            <!-- Colonna 1: Tradizione -->
            <div class="col-md-3 col-sm-6">
                <div class="p-3">
                    <i class="bi bi-award fs-1 text-danger mb-3"></i>
                    <h4 class="brand-font">30 Anni di Tradizione</h4>
                    <p class="text-muted small">Ristorante e pizzeria con oltre trent'anni di attività continua, guidati dalla passione per la buona cucina, cerchiamo di accogliere chiunque al meglio delle nostre possibilita'</p>
                </div>
            </div>


 <!-- Colonna 4: Eventi -->
            <div class="col-md-3 col-sm-6">
                <div class="p-3">
                    <i class="bi bi-heart-fill fs-1 text-danger mb-3"></i>
                    <h4 class="brand-font">Eventi Speciali</h4>
                    <p class="text-muted small">Matrimoni, battesimi, comunioni, cresime e per ogni occasione speciale: vasta scelta di menù personalizzati con attenzione a intolleranze e regimi alimentari specifici.</p>
                </div>
            </div>
             <!-- Colonna 3: Bosco -->
            <div class="col-md-3 col-sm-6">
                <div class="p-3">
                    <i class="bi bi-tree fs-1 text-danger mb-3"></i>
                    <h4 class="brand-font">A Bordo Bosco</h4>
                    <p class="text-muted small">Goditi il tuo pasto avvolto dalla natura: una splendida terrazza esterna per le giornate estive, Veranda esterna spaziosa e numerosi posti a sedere interni.</p>
                </div>
            </div>

           

            <!-- Colonna 2: La Giazzèra -->
            <div class="col-md-3 col-sm-6">
                <div class="p-3">
                    <i class="bi bi-snow fs-1 text-danger mb-3"></i>
                    <h4 class="brand-font">La Giazzèra Storica</h4>
                    <p class="text-muted small">Sotto il Crotto si cela una ghiacciaia di sasso profonda 4 metri. Un tempo alimentata dal ghiaccio della vicina Lagozza, usava un ingegnoso drenaggio per conservare cibi e rifornire il territorio.</p>
                </div>
            </div>

           
        </div>
    </div>
</section>
<!-- Featured Dishes from Database -->
@if (Model.FeaturedDishes.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="brand-font mb-2">I Nostri Piatti del Giorno</h2>
                <p class="text-muted">Alcune delle nostre specialità più amate preparate secondo le antiche ricette</p>
            </div>
            <div class="row g-4">
                @foreach (var dish in Model.FeaturedDishes)
                {
                    <div class="col-md-6">
                        <div class="menu-item-row h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h5 class="menu-item-name mb-0">@dish.Name</h5>
                                    <span class="menu-item-price">@settings.CurrencySymbol @dish.Price.ToString("F2")</span>
                                </div>
                                <span class="badge bg-light text-secondary border small mt-1">@dish.Category?.Name</span>
                                @if (!string.IsNullOrWhiteSpace(dish.Description))
                                {
                                    <p class="menu-item-desc">@dish.Description</p>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(dish.Allergens))
                            {
                                <div class="menu-item-allergens mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Allergeni: @dish.Allergens
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-page="/Menu" class="btn btn-crotto">
                    Scopri tutto il Menu Completo <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- Takeaway, Delivery & Events Callout -->
<section class="py-5 bg-white border-top">
    <div class="container">
        <div class="row align-items-center g-4">
            <!-- Left Column: Info & Details -->
            <div class="col-lg-6">
                <h2 class="brand-font mb-3">Prenotazioni, Asporto ed Eventi</h2>
                
                <!-- Sezione Prenotazione Tavoli -->
                <div class="mb-3">
                    <h6 class="fw-bold mb-1"><i class="bi bi-calendar-check me-1 text-danger"></i> Prenotazione Tavoli</h6>
                    <p class="text-muted small mb-1">
                        Chiamaci per riservare il tuo tavolo. È inoltre possibile richiedere un tavolo lasciando un messaggio in segreteria: <span class="text-danger">verrete ricontattati per la conferma della disponibilità.</span>
                    </p>
                </div>

                <!-- Sezione Asporto -->
                <div class="mb-3">
                    <h6 class="fw-bold mb-1"><i class="bi bi-bag-check me-1 text-danger"></i> Servizio Asporto</h6>
                    <p class="text-muted small mb-0">
                        Chiamate, ordinate quello che desiderate e passate a ritirare i vostri piatti preferiti senza alcun costo aggiuntivo. Gusta i sapori autentici della nostra pizzeria e ristorante comodo a casa tua.
                    </p>
                </div>

                <!-- Sezione Eventi e Banchetti -->
                <div class="mb-4">
                    <h6 class="fw-bold mb-1"><i class="bi bi-people me-1 text-danger"></i> Eventi e Banchetti</h6>
                    <p class="text-muted small mb-0">
                        Organizziamo feste, cerimonie e cene di gruppo. Per preventivi e informazioni personalizzate sui menu dedicati, <a href="mailto:@settings.Email" class="text-danger fw-bold text-decoration-none">inviaci una mail</a>.
                    </p>
                </div>

                <!-- Hours & Contact (Full width per item on mobile) -->
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <h6 class="fw-bold mb-1"><i class="bi bi-clock me-1 text-danger"></i> Orari</h6>
                        <p class="small text-muted mb-0">@settings.OpeningHoursWeekday</p>
                        <p class="small text-muted mb-0">@settings.OpeningHoursHoliday</p>
                    </div>
                    <div class="col-12 col-sm-6">
                        <h6 class="fw-bold mb-1"><i class="bi bi-telephone me-1 text-danger"></i> Contatto</h6>
                        <p class="small text-muted mb-1">Le chiamate verranno accettate durante e in prossimità degli orari lavorativi.</p>
                        <a class="small fw-bold text-danger text-decoration-none" href="tel:@settings.Phone">
                            <i class="bi bi-telephone-fill me-1"></i>@settings.Phone
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Column: Action Cards -->
            <div class="col-lg-6">
                <div class="d-flex flex-column gap-3">
                    
                    <!-- Card Eventi e Banchetti (Email) -->
                    <div class="p-4 border rounded bg-light text-center">
                        <i class="bi bi-envelope-paper fs-2 text-danger mb-2"></i>
                        <h5 class="brand-font mb-2">Eventi &amp; Banchetti</h5>
                        <p class="small text-muted mb-3">Vuoi festeggiare un'occasione speciale da noi? Scrivici per definire il tuo menu personalizzato.</p>
                        <a href="mailto:@settings.Email" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-envelope me-1"></i> @settings.Email
                        </a>
                    </div>

                    <!-- Card Consegna a Domicilio -->
                    <div class="p-3 border rounded bg-light text-center">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="text-start">
                                <h6 class="brand-font mb-0"><i class="bi bi-truck me-1 text-danger"></i> Consegna a Domicilio</h6>
                                <p class="small text-muted mb-0">Ordina comodamente a casa tua su Just Eat.</p>
                            </div>
                            <a href="https://www.justeat.it/restaurants-ristorante-crotto-plinius-induno-olona/menu?shipping=pickup" target="_blank" rel="noopener noreferrer" class="btn btn-danger btn-sm">
                                <i class="bi bi-box-seam me-1"></i> Ordina su Just Eat
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>