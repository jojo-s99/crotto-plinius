@page
@model CrottoPlinius.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Pannello di Amministrazione";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="brand-font mb-0">Gestione Menu & Locale</h2>
            <p class="text-muted small mb-0">Modifica piatti, prezzi e disponibilità in tempo reale</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/Categories/Create" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-folder-plus me-1"></i>Nuova Categoria
            </a>
            <a asp-page="/Admin/Dishes/Create" class="btn btn-crotto btn-sm">
                <i class="bi bi-plus-circle me-1"></i>Aggiungi Piatto
            </a>

    <a  asp-page="/Admin/Sales/Index" class="btn btn-crotto btn-sm">
        <i class="bi bi-cart-check me-1"></i> Vendite
    </a>

        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Piatti Totali</div>
                        <div class="fs-3 fw-bold text-dark">@Model.TotalDishes</div>
                    </div>
                    <i class="bi bi-card-list fs-1 text-secondary opacity-50"></i>
                </div>
                <a asp-page="/Admin/Dishes/Index" class="small text-decoration-none mt-2 d-inline-block">Vedi tutti &rarr;</a>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Disponibili Oggi</div>
                        <div class="fs-3 fw-bold text-success">@Model.AvailableDishes</div>
                    </div>
                    <i class="bi bi-check-circle fs-1 text-success opacity-50"></i>
                </div>
                <span class="small text-muted mt-2 d-inline-block">Visibili ai clienti nel menu</span>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Esauriti / Nascosti</div>
                        <div class="fs-3 fw-bold @(Model.UnavailableDishes.Any() ? "text-danger" : "text-muted")">
                            @Model.UnavailableDishes.Count
                        </div>
                    </div>
                    <i class="bi bi-dash-circle fs-1 text-danger opacity-50"></i>
                </div>
                <span class="small text-muted mt-2 d-inline-block">Temporaneamente nascosti</span>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Categorie Attive</div>
                        <div class="fs-3 fw-bold text-primary">@Model.ActiveCategories / @Model.TotalCategories</div>
                    </div>
                    <i class="bi bi-folder2-open fs-1 text-primary opacity-50"></i>
                </div>
                <a asp-page="/Admin/Categories/Index" class="small text-decoration-none mt-2 d-inline-block">Gestisci sezioni &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Alert for dishes currently turned OFF -->
    @if (Model.UnavailableDishes.Any())
    {
        <div class="card border-warning mb-4">
            <div class="card-header bg-warning bg-opacity-10 text-dark fw-bold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Piatti attualmente contrassegnati come NON DISPONIBILI</span>
                <span class="badge bg-warning text-dark">@Model.UnavailableDishes.Count piatti</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th>Nome Piatto</th>
                                <th>Categoria</th>
                                <th>Prezzo</th>
                                <th class="text-end">Azione Rapida</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dish in Model.UnavailableDishes)
                            {
                                <tr>
                                    <td class="fw-semibold">@dish.Name</td>
                                    <td><span class="badge bg-light text-secondary border">@dish.Category?.Name</span></td>
                                    <td>€ @dish.Price.ToString("F2")</td>
                                    <td class="text-end">
                                        <form method="post" asp-page="/Admin/Dishes/Toggle" asp-route-id="@dish.Id" class="d-inline">
                                            <input type="hidden" name="returnUrl" value="/Admin/Index" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check2 me-1"></i>Rendi Disponibile
                                            </button>
                                        </form>
                                        <a asp-page="/Admin/Dishes/Edit" asp-route-id="@dish.Id" class="btn btn-sm btn-outline-secondary ms-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Quick Management Hub -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-card-checklist fs-2 text-danger me-3"></i>
                        <div>
                            <h4 class="brand-font mb-0">Gestione Piatti & Prezzi</h4>
                            <p class="small text-muted mb-0">Aggiorna prezzi, descrizioni e disponibilità</p>
                        </div>
                    </div>
                    <p class="small text-muted">
                        Visualizza tutti i piatti divisi per categoria, modifica i prezzi con un clic o metti temporaneamente fuori menu una pietanza terminata.
                    </p>
                    <a asp-page="/Admin/Dishes/Index" class="btn btn-crotto btn-sm">
                        Vai alla Lista Piatti <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-folder fs-2 text-secondary me-3"></i>
                        <div>
                            <h4 class="brand-font mb-0">Categorie del Menu</h4>
                            <p class="small text-muted mb-0">Organizzazione sezioni (Antipasti, Primi, Dolci...)</p>
                        </div>
                    </div>
                    <p class="small text-muted">
                        Modifica l'ordine con cui le categorie appaiono nel menu o aggiungi una nuova sezione (ad esempio per una stagione o festività).
                    </p>
                    <a asp-page="/Admin/Categories/Index" class="btn btn-outline-secondary btn-sm">
                        Gestisci Categorie <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
