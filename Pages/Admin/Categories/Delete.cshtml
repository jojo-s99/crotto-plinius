@page "{id:int}"
@model CrottoPlinius.Pages.Admin.Categories.DeleteModel
@{
    ViewData["Title"] = "Elimina Categoria";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="mb-3">
                <a asp-page="./Index" class="text-decoration-none small text-muted">&larr; Torna a Categorie</a>
            </div>

            <div class="card border-danger shadow-sm p-4">
                <div class="text-center mb-3 text-danger">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                    <h3 class="brand-font mt-2">Conferma Eliminazione</h3>
                </div>

                <p class="text-center text-muted">
                    Sei sicuro di voler eliminare la categoria <strong>"@Model.Category.Name"</strong>?
                </p>

                @if (Model.AssociatedDishesCount > 0)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        <strong>Attenzione:</strong> Questa categoria contiene <strong>@Model.AssociatedDishesCount</strong> piatti collegati. Eliminando la categoria verranno eliminati anche tutti i piatti contenuti.
                    </div>
                }

                <form method="post" class="d-flex justify-content-center gap-3 mt-3">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">Annulla</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>Elimina Definitivamente
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
