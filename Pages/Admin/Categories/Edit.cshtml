@page "{id:int}"
@model CrottoPlinius.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = "Modifica Categoria";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="mb-3">
                <a asp-page="./Index" class="text-decoration-none small text-muted">&larr; Torna a Categorie</a>
            </div>

            <div class="card border-0 shadow-sm p-4">
                <h3 class="brand-font mb-3">Modifica Categoria</h3>

                <form method="post" enctype="multipart/form-data" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                    <input type="hidden" asp-for="Category.Id" />
                    <input type="hidden" asp-for="Category.ImageUrl" />

                    <div class="mb-3">
                        <label asp-for="Category.Name" class="form-label fw-semibold"></label>
                        <input asp-for="Category.Name" class="form-control" />
                        <span asp-validation-for="Category.Name" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category.Description" class="form-label fw-semibold"></label>
                        <input asp-for="Category.Description" class="form-control" />
                        <span asp-validation-for="Category.Description" class="text-danger small d-block mt-1"></span>
                    </div>

                    <!-- Gestione Immagine Categoria -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Immagine Categoria</label>

                        @if (!string.IsNullOrWhiteSpace(Model.Category.ImageUrl))
                        {
                            <div class="d-flex align-items-center gap-3 mb-2 p-2 border rounded bg-light">
                                <img src="@Model.Category.ImageUrl" alt="@Model.Category.Name" class="rounded object-fit-cover" style="width: 70px; height: 70px;" />
                                <div class="flex-grow-1">
                                    <span class="small text-muted d-block text-truncate" style="max-width: 250px;">@Model.Category.ImageUrl</span>
                                    <div class="form-check mt-1">
                                        <input class="form-check-input" type="checkbox" asp-for="RemoveImage" id="removeImageCheck" />
                                        <label class="form-check-label text-danger small fw-semibold" for="removeImageCheck">
                                            Rimuovi immagine esistente
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }

                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/png, image/jpeg, image/webp" />
                        <span class="form-text small text-muted">Carica un file (JPG, PNG, WEBP) per impostare o sostituire l'immagine.</span>
                        <span asp-validation-for="ImageFile" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="Category.SortOrder" class="form-label fw-semibold"></label>
                            <input asp-for="Category.SortOrder" class="form-control" type="number" min="0" step="1" />
                            <span class="form-text small text-muted d-block mt-1">Posizione nel menu (1 = in cima)</span>
                            <span asp-validation-for="Category.SortOrder" class="text-danger small d-block mt-1"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-md-3">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="Category.IsActive" id="isActiveSwitch">
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">Categoria Visibile nel Menu</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-page="./Index" class="btn btn-outline-secondary">Annulla</a>
                        <button type="submit" class="btn btn-crotto">
                            <i class="bi bi-check-lg me-1"></i>Salva Modifiche
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}