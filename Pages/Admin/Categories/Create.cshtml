@page
@model CrottoPlinius.Pages.Admin.Categories.CreateModel
@{
    ViewData["Title"] = "Nuova Categoria";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="mb-3">
                <a asp-page="./Index" class="text-decoration-none small text-muted">&larr; Torna a Categorie</a>
            </div>

            <div class="card border-0 shadow-sm p-4">
                <h3 class="brand-font mb-3">Crea Nuova Categoria</h3>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Category.Name" class="form-label fw-semibold"></label>
                        <input asp-for="Category.Name" class="form-control" placeholder="Es. Dolci della Tradizione" autofocus />
                        <span asp-validation-for="Category.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category.Description" class="form-label fw-semibold"></label>
                        <input asp-for="Category.Description" class="form-control" placeholder="Es. Dessert fatti a mano ogni giorno" />
                        <span asp-validation-for="Category.Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="Category.SortOrder" class="form-label fw-semibold"></label>
                            <input asp-for="Category.SortOrder" class="form-control" type="number" />
                            <span class="form-text small">Numero progressivo per decidere la posizione nel menu (1, 2, 3...)</span>
                            <span asp-validation-for="Category.SortOrder" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-md-3">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="Category.IsActive" id="isActiveSwitch">
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">Categoria Visibile nel Menu</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-page="./Index" class="btn btn-outline-secondary">Annulla</a>
                        <button type="submit" class="btn btn-crotto">
                            <i class="bi bi-check-lg me-1"></i>Salva Categoria
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
