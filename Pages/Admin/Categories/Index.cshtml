@page
@model CrottoPlinius.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "Gestione Categorie";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="small text-muted"><a asp-page="/Admin/Index" class="text-decoration-none">&larr; Torna al Pannello</a></div>
            <h2 class="brand-font mb-0">Categorie Menu</h2>
            <p class="text-muted small mb-0">Imposta le sezioni del menu e il loro ordine di apparizione</p>
        </div>
        <a asp-page="/Admin/Categories/Create" class="btn btn-crotto btn-sm">
            <i class="bi bi-folder-plus me-1"></i>Nuova Categoria
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Ordine</th>
                        <th>Nome Categoria</th>
                        <th>Descrizione</th>
                        <th style="width: 120px;">N° Piatti</th>
                        <th style="width: 100px;">Stato</th>
                        <th class="text-end" style="width: 180px;">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Categories.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                Nessuna categoria presente. Crea la prima categoria cliccando su "Nuova Categoria".
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cat in Model.Categories)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">@cat.SortOrder</span>
                                </td>
                                <td class="fw-bold">
                                    @cat.Name
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(cat.Description) ? "—" : cat.Description)
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@cat.Dishes.Count piatti</span>
                                </td>
                                <td>
                                    @if (cat.IsActive)
                                    {
                                        <span class="badge bg-success">Attiva</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Nascosta</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-page="/Admin/Categories/Edit" asp-route-id="@cat.Id" class="btn btn-outline-secondary" title="Modifica">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="/Admin/Categories/Delete" asp-route-id="@cat.Id" class="btn btn-outline-danger" title="Elimina">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
