@page "{id:int}"
@model CrottoPlinius.Pages.Admin.Dishes.EditModel
@{
    ViewData["Title"] = "Modifica Piatto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="mb-3">
                <a asp-page="./Index" class="text-decoration-none small text-muted">&larr; Torna ai Piatti</a>
            </div>

            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="brand-font mb-0">Modifica Piatto: @Model.Dish.Name</h3>
                    <span class="badge bg-light text-secondary border">ID #@Model.Dish.Id</span>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <input type="hidden" asp-for="Dish.Id" />

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="Dish.MenuCategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="Dish.MenuCategoryId" asp-items="Model.CategoryList" class="form-select"></select>
                            <span asp-validation-for="Dish.MenuCategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Dish.Name" class="form-label fw-semibold"></label>
                            <input asp-for="Dish.Name" class="form-control" />
                            <span asp-validation-for="Dish.Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dish.Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Dish.Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Dish.Description" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label asp-for="Dish.Price" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input asp-for="Dish.Price" class="form-control" type="number" step="0.50" min="0" />
                            </div>
                            <span asp-validation-for="Dish.Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Dish.SortOrder" class="form-label fw-semibold"></label>
                            <input asp-for="Dish.SortOrder" class="form-control" type="number" />
                            <span class="form-text small">Posizione all'interno della categoria (1 = in alto)</span>
                            <span asp-validation-for="Dish.SortOrder" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dish.Allergens" class="form-label fw-semibold"></label>
                        <input asp-for="Dish.Allergens" class="form-control" placeholder="Es. Glutine, Lattosio" />
                        <span asp-validation-for="Dish.Allergens" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4 bg-light p-3 rounded mx-0">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Dish.IsAvailable" id="isAvailableSwitch">
                                <label class="form-check-label fw-semibold" for="isAvailableSwitch">Disponibile oggi</label>
                                <div class="form-text small">Se disattivato, il piatto scompare dal menu visibile ai clienti.</div>
                            </div>
                        </div>
                        <div class="col-md-6 mt-3 mt-md-0">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Dish.IsFeatured" id="isFeaturedSwitch">
                                <label class="form-check-label fw-semibold" for="isFeaturedSwitch">Piatto del Giorno / In Evidenza</label>
                                <div class="form-text small">Mostrato in homepage tra le specialità.</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-page="./Index" class="btn btn-outline-secondary">Annulla</a>
                        <button type="submit" class="btn btn-crotto">
                            <i class="bi bi-check-lg me-1"></i>Salva Modifiche
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
