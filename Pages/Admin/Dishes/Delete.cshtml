@page "{id:int}"
@model CrottoPlinius.Pages.Admin.Dishes.DeleteModel
@{
    ViewData["Title"] = "Elimina Piatto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="mb-3">
                <a asp-page="./Index" class="text-decoration-none small text-muted">&larr; Torna ai Piatti</a>
            </div>

            <div class="card border-danger shadow-sm p-4">
                <div class="text-center mb-3 text-danger">
                    <i class="bi bi-trash3-fill fs-1"></i>
                    <h3 class="brand-font mt-2">Conferma Eliminazione Piatto</h3>
                </div>

                <div class="p-3 bg-light rounded mb-3">
                    <div class="fw-bold fs-5 text-dark">@Model.Dish.Name</div>
                    <div class="text-muted small">Categoria: @Model.Dish.Category?.Name</div>
                    <div class="text-danger fw-bold mt-1">€ @Model.Dish.Price.ToString("F2")</div>
                </div>

                <p class="text-center text-muted small">
                    Questa operazione rimuoverà definitivamente il piatto dal database. Se preferisci soltanto nasconderlo dal menu per oggi, puoi impostare la disponibilità su <strong>"Esaurito"</strong>.
                </p>

                <form method="post" class="d-flex justify-content-center gap-3 mt-3">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">Annulla</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>Elimina Definitivamente
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
