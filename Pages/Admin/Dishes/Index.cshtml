@page
@model CrottoPlinius.Pages.Admin.Dishes.IndexModel
@{
    ViewData["Title"] = "Gestione Piatti & Prezzi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="small text-muted"><a asp-page="/Admin/Index" class="text-decoration-none">&larr; Torna al Pannello</a></div>
            <h2 class="brand-font mb-0">Gestione Piatti del Menu</h2>
            <p class="text-muted small mb-0">Aggiorna prezzi, descrizioni e attiva/disattiva i piatti con un clic</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/Dishes/Create" class="btn btn-crotto btn-sm">
                <i class="bi bi-plus-circle me-1"></i>Aggiungi Nuovo Piatto
            </a>
        </div>
    </div>

    <!-- Filter / Search Toolbar -->
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Cerca piatto o ingrediente..." />
                </div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-secondary btn-sm">Filtra</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm ms-1">Azzera filtro</a>
                }
            </div>
        </form>
    </div>

    <!-- Dishes Grouped by Category -->
    @if (!Model.Categories.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <i class="bi bi-inbox fs-1 text-muted mb-2"></i>
            <h5>Nessun piatto trovato</h5>
            <p class="text-muted small">Crea una categoria e poi aggiungi il tuo primo piatto.</p>
            <div>
                <a asp-page="/Admin/Dishes/Create" class="btn btn-crotto btn-sm">Aggiungi Piatto</a>
            </div>
        </div>
    }
    else
    {
        @foreach (var cat in Model.Categories)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <div>
                        <span class="badge bg-secondary me-2">Pos. @cat.SortOrder</span>
                        <span class="fw-bold fs-5 brand-font text-dark">@cat.Name</span>
                        @if (!cat.IsActive)
                        {
                            <span class="badge bg-danger ms-2">Categoria Nascosta</span>
                        }
                    </div>
                    <a asp-page="/Admin/Dishes/Create" asp-route-categoryId="@cat.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-plus me-1"></i>Aggiungi in @cat.Name
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th style="width: 70px;">Pos.</th>
                                <th>Nome Piatto</th>
                                <th style="width: 120px;">Prezzo</th>
                                <th style="width: 160px;">Disponibilità Oggi</th>
                                <th style="width: 100px;">Allergeni</th>
                                <th class="text-end" style="width: 160px;">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!cat.Dishes.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3 text-muted small">
                                        Nessun piatto presente in questa categoria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var dish in cat.Dishes)
                                {
                                    <tr class="@(!dish.IsAvailable ? "table-light opacity-75" : "")">
                                        <td>
                                            <span class="text-muted small">#@dish.SortOrder</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">
                                                @dish.Name
                                                @if (dish.IsFeatured)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1 small" style="font-size: 0.65rem;">Specialità</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(dish.Description))
                                            {
                                                <div class="small text-muted text-truncate" style="max-width: 380px;">@dish.Description</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">€ @dish.Price.ToString("F2")</span>
                                        </td>
                                        <td>
                                            <form method="post" asp-page="./Toggle" asp-route-id="@dish.Id" class="d-inline">
                                                <input type="hidden" name="returnUrl" value="@(Request.Path + Request.QueryString)" />
                                                @if (dish.IsAvailable)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" title="Clicca per segnare come Esaurito">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Disponibile
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Clicca per segnare come Disponibile">
                                                        <i class="bi bi-x-circle-fill me-1"></i>Esaurito
                                                    </button>
                                                }
                                            </form>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(dish.Allergens))
                                            {
                                                <span class="badge bg-light text-secondary border small text-truncate" style="max-width: 120px;" title="@dish.Allergens">
                                                    @dish.Allergens
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-page="./Edit" asp-route-id="@dish.Id" class="btn btn-outline-secondary" title="Modifica Piatto / Prezzo">
                                                    <i class="bi bi-pencil"></i> Modifica
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@dish.Id" class="btn btn-outline-danger" title="Elimina Piatto">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
