@inject IOptions<RestaurantSettings> RestaurantOptions
@{
    var settings = RestaurantOptions.Value;
    var currentPath = Context.Request.Path.Value ?? "";
    var isAdmin = currentPath.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - {settings.Name}" : $"{settings.Name} - {settings.Tagline}")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? settings.Description)" />
    <meta property="og:title" content="@(ViewData["Title"] ?? settings.Name)" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? settings.Description)" />
    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="it_IT" />



    <!-- ... altri tag ... -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <!-- Oppure per un file PNG: -->
    <!-- <link rel="icon" type="image/png" href="~/images/logo.png" /> -->

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-crotto">
          <div class="container">
    <a class="navbar-brand py-0" asp-page="/Index">
        <!-- Logo Desktop -->
        <img src="~/images/logo.png" alt="@settings.Name" height="84" class="d-none d-md-inline align-text-top" />
        
        <!-- Logo Mobile -->
        <img src="~/images/logo.png" alt="@settings.Name" height="64" class="d-inline d-md-none align-text-top" />
   
     <!-- @settings.Name -->
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
            aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

   <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
            @if (isAdmin)
            {
                <li class="nav-item">
                    <a class="nav-link @(currentPath.Equals("/Admin", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/Admin/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Admin/Index">
                        <i class="bi bi-speedometer2 me-1"></i>Pannello
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/Admin/Categories", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Admin/Categories/Index">
                        <i class="bi bi-folder me-1"></i>Categorie
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/Admin/Dishes", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Admin/Dishes/Index">
                        <i class="bi bi-card-list me-1"></i>Piatti
                    </a>
                </li>
                <li class="nav-item ms-lg-2">
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Menu" target="_blank">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Vedi Menu Pubblico
                    </a>
                </li>
                <li class="nav-item ms-lg-2">
                    <form method="post" asp-page="/Admin/Logout" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>Esci
                        </button>
                    </form>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link @(currentPath.Equals("/") || currentPath.Equals("/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Index">
                        <i class="bi bi-house me-1"></i>Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/Menu", StringComparison.OrdinalIgnoreCase) ? "active fw-bold" : "fw-bold")" asp-page="/Menu">
                        <i class="bi bi-book me-1"></i>Menu
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/About", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/About">
                        <i class="bi bi-info-circle me-1"></i>Chi Siamo
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/Giazzera", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Giazzera">
                        <i class="bi bi-snow me-1"></i>Giazzera
                    </a>
                </li>
                
                <li class="nav-item ms-lg-2">
                    <a class="btn btn-crotto btn-sm" asp-page="/Contact">
                        <i class="bi bi-telephone-fill me-1"></i>Contatti
                    </a>
                </li>
            }
        </ul>
    </div>
</div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">

        @RenderBody()
<partial name="_CookieConsentPartial" />   

    </main>

    <footer class="crotto-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="text-white mb-3 brand-font">@settings.Name</h5>
                    <p class="small text-secondary mb-2">@settings.Tagline</p>
                   <a class="small text-secondary text-decoration-none" href="https://maps.google.com/?q=@Uri.EscapeDataString(settings.Address)" target="_blank">
    <i class="bi bi-geo-alt me-2 text-danger"></i>@settings.Address
</a>
                    </br>
                   <a class="small text-secondary mb-0 text-decoration-none" href="tel:@settings.Phone">
                   <i class="bi bi-telephone me-2 text-danger"></i>
                   @settings.Phone</a>
                       
                   
                </div>
                <div class="col-md-4">
                    <h5 class="text-white mb-3">Orari di Apertura</h5>
                    <p class="small text-secondary">@settings.OpeningHoursWeekday</p>
                    <p class="small text-secondary">@settings.OpeningHoursHoliday</p>
                    <p class="small text-secondary">Prenotazione consigliata per il weekend.</p>
                </div>
                <div class="col-md-4">
                    <h5 class="text-white mb-3">Collegamenti Rapidi</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a asp-page="/Menu">Menu Completo</a></li>
                        <li class="mb-1"><a asp-page="/About">La Nostra Storia</a></li>
                        <li class="mb-1"><a asp-page="/Contact">Come Raggiungerci</a></li>
                        <li class="mt-3"><a asp-page="/Admin/Index" class="text-secondary opacity-50"><i class="bi bi-lock me-1"></i>Area Riservata</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary mt-4 mb-3" />
            <div class="d-flex justify-content-between align-items-center flex-wrap small text-secondary">
                <span>&copy; @DateTime.UtcNow.Year @settings.Name - Tutti i diritti riservati.</span>
                <span>P.Iva: 01985470127 | REA: VA222020 | PEC: isimeoni@mypec.eu</span>
                <a asp-page="/Privacy" class="text-warning small">Privacy & Cookie Policy</a>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


<!-- Inserisci nel tuo _Layout.cshtml -->
<script>
    function loadAnalytics() {
        if (window.gtag_loaded) return;
        window.gtag_loaded = true;
        
        // Esempio caricamento dinamico di Google Analytics
        var script = document.createElement('script');
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-YOUR_TRACKING_ID';
        script.async = true;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-YOUR_TRACKING_ID');
    }

    // Controlla al caricamento della pagina
    document.addEventListener("DOMContentLoaded", function () {
        var prefs = JSON.parse(localStorage.getItem("user_cookie_preferences") || "{}");
        if (prefs.analytics) {
            loadAnalytics();
        }
    });

    // Ascolta se l'utente aggiorna il consenso dal banner
    window.addEventListener("cookieConsentUpdated", function (e) {
        if (e.detail.analytics) {
            loadAnalytics();
        }
    });
</script>