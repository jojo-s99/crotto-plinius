@page
@model ErrorModel
@{
    ViewData["Title"] = "Errore";
}

<div class="container py-5 text-center">
    <i class="bi bi-exclamation-octagon text-danger fs-1 mb-3"></i>
    <h1 class="brand-font">Si è verificato un errore</h1>
    <p class="text-muted">Si è verificato un problema durante l'elaborazione della richiesta.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-page="/Index" class="btn btn-crotto mt-3">Torna alla Pagina Iniziale</a>
</div>
