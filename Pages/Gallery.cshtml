@page
@model GalleryModel
@inject IOptions<RestaurantSettings> RestaurantOptions
@{
    var settings = RestaurantOptions.Value;
    ViewData["Title"] = "Galleria Fotografica";
}

<div class="bg-white border-bottom py-4 text-center">
    <div class="container">
        <h1 class="brand-font display-5 mb-2">Galleria Fotografica</h1>
        <p class="text-muted mb-0 small">Scorci del crotto, i nostri piatti e l'atmosfera unica del Lago di Como</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80" 
                     class="card-img-top" alt="Atmosfera del ristorante" style="height: 260px; object-fit: cover;">
                <div class="card-body p-3">
                    <h6 class="brand-font mb-1">La Sala Principale</h6>
                    <p class="small text-muted mb-0">Tavoli in legno massello e mura in pietra a vista.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1621996346565-e3d5d6281729?auto=format&fit=crop&w=800&q=80" 
                     class="card-img-top" alt="Pasta fresca artigianale" style="height: 260px; object-fit: cover;">
                <div class="card-body p-3">
                    <h6 class="brand-font mb-1">Pasta Fatta a Mano</h6>
                    <p class="small text-muted mb-0">Pizzoccheri e gnocchetti preparati ogni giorno.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=800&q=80" 
                     class="card-img-top" alt="Cantina vini" style="height: 260px; object-fit: cover;">
                <div class="card-body p-3">
                    <h6 class="brand-font mb-1">La Cantina Naturale</h6>
                    <p class="small text-muted mb-0">Affidamento al sorèl per una maturazione perfetta.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=800&q=80" 
                     class="card-img-top" alt="Carni e arrosti" style="height: 260px; object-fit: cover;">
                <div class="card-body p-3">
                    <h6 class="brand-font mb-1">Cotture Lente</h6>
                    <p class="small text-muted mb-0">Brasati e costine insaporiti con erbe lariane.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=800&q=80" 
                     class="card-img-top" alt="Dolci e dessert" style="height: 260px; object-fit: cover;">
                <div class="card-body p-3">
                    <h6 class="brand-font mb-1">I Nostri Dolci</h6>
                    <p class="small text-muted mb-0">La tradizionale Miascia e dessert genuini.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm overflow-hidden h-100">
                <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80" 
                     class="card-img-top" alt="Lago di Como panorama" style="height: 260px; object-fit: cover;">
                <div class="card-body p-3">
                    <h6 class="brand-font mb-1">La Vista sul Lago</h6>
                    <p class="small text-muted mb-0">A pochi passi dalla riva romantica di Torno.</p>
                </div>
            </div>
        </div>
    </div>
</div>
